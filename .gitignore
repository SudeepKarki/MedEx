# See https://git-scm.com/docs/gitignore

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js (build output, generated types)
/.next/
/out/
/build
next-env.d.ts

# typescript
*.tsbuildinfo

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# env files (never commit secrets)
.env*

# deployment
.vercel

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# tool caches
.eslintcache
.prettiercache

# editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# misc
*.pem

# local AI-assistant state (session locks, personal settings)
.claude/
CLAUDE.local.md
